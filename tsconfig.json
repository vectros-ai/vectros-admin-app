{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,

    "baseUrl": ".",
    "paths": {
      // tsc consumes the package's BUILT declarations (flat .d.ts → resolves
      // react/@mui against THIS app's single copy, avoiding the dual-@types/react
      // clash that deep-checking the aliased source would cause). Runtime uses
      // the src alias in vite.config.ts (fast dev). Run `npm run build -w
      // @vectros-ai/react` after changing the lib's types. (Both go away at the
      // registry-pin release cut.)
      // CognitoAuthProvider is its own entry point, not value-exported from
      // the main bundle (see that package's tsup.config.ts) — mirror the
      // alias above for the subpath this app actually imports.
      // Pin react/react-dom types to THIS app's single @types copy. Without this,
      // the app's own @types/react and the one the lib's flat .d.ts references
      // (resolved from the repo root) are two distinct React identities — which
      // MUI's `Autocomplete renderInput → TextField` surfaces as a spurious
      // `ref` "two different types with this name exist" error (TS2322). app
      // surfaces that ScopeEditor/ProfileEditor pattern; app-vectros doesn't, so
      // it stayed latent. Collapsing to one copy fixes tsc deterministically.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },

    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"]
}
