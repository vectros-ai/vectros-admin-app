# ---------------------------------------------------------------------------
# Vectros Admin App — environment configuration template
#
# Copy this file to `.env.local` for local development. NEVER commit a real
# `.env.local`. Production values are injected at build time by your deploy
# pipeline as VITE_* env vars before `npm run build`.
#
# Vite exposes ONLY variables prefixed `VITE_` to the client bundle. Any
# secret pattern (passwords, signing keys, etc.) MUST NOT live here — this
# file is shipped to the browser. Cognito User Pool IDs + Client IDs are
# safe to ship; they are public identifiers.
#
# LOCAL DEV PREREQUISITES (two traps that make `npm run dev` "not work"):
#  1. Build the shared react package FIRST. vite.config.ts aliases
#     `@vectros-ai/react` to `../../packages/react/dist/index.mjs` (its built
#     bundle, gitignored), so a fresh checkout must run, from the repo root:
#        npm install
#        npm run build -w @vectros-ai/react
#     Otherwise the dev server fails to resolve the import.
#  2. After REBUILDING that package, restart the dev server with a cleared
#     Vite cache: `rm -rf node_modules/.vite` then restart. Vite caches the
#     optimized dep and otherwise keeps serving the OLD bundle (a stale gate /
#     blank screen even though the fix is built).
#
# Point the VITE_* values below at your own Cognito user pool + API
# deployment. Use the edge / CDN host for the API URLs — a raw API-Gateway
# host rejects the CORS preflight.
# ---------------------------------------------------------------------------

# Cognito User Pool ID. The region is encoded as the prefix
# (e.g. `us-east-1_ABC123` → us-east-1); Amplify v6 derives it automatically.
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito User Pool App Client ID. This app authenticates via Cognito SRP
# (direct API, not Hosted UI / OAuth redirect), so a single client works
# without a per-subdomain callback-URL allow-list.
VITE_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Developer API base URL. The app calls `GET <this>/developer/scoped-token`
# to mint a Vectros-API bearer (Cognito ID token in the Authorization header
# → a scoped token back). Split from the Vectros API URL below so a fork or a
# split-domain deployment can point them at different origins.
VITE_DEVELOPER_API_URL=https://api.example.com

# Vectros API base URL. The minted bearer unlocks /v1/* — Members, Scoped
# Keys, Logs all route through here. See VITE_DEVELOPER_API_URL for why this
# is a separate variable.
VITE_VECTROS_API_URL=https://api.example.com
